---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { getReadingPriority, getCompactDescription } from "@lib/posts";
import { getProjectForPost } from "@lib/projects";
import { getTopic } from "@lib/taxonomy";
interface Props { post: CollectionEntry<"blog">; compact?: boolean; heading?: "h2" | "h3"; }
const { post, compact = false, heading: Heading = "h3" } = Astro.props;
const date = post.data.pubDate.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" });
const project = getProjectForPost(post);
---
<a class:list={["post-row", { "post-row--compact": compact }]}
  href={"/posts/" + post.id + "/"} aria-label={post.data.title + " 글 읽기"}
  data-post-tags={post.data.tags.join("|")} data-post-category={post.data.category} data-post-priority={getReadingPriority(post)} data-post-date={post.data.pubDate.valueOf()}>
  <div class="post-row-main">
    {!compact && <p class="article-meta"><span>{getTopic(post.data.category)}</span>{project && <span>{project.name}</span>}<time datetime={post.data.pubDate.toISOString()}>{date}</time>{post.data.kind === "learning-note" && <span>학습 노트</span>}</p>}
    <Heading>{post.data.title}</Heading>
    <p class="post-description">{compact ? getCompactDescription(post) : post.data.description}</p>
    {!compact && <ul class="tag-list" aria-label="기술 태그">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
  </div>
  <span class="post-row-end">{compact && <span class="post-topic">{getTopic(post.data.category)}</span>}<Icon /></span>
</a>
