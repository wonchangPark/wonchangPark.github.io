---
import BaseLayout from "./BaseLayout.astro";
import Icon from "@components/Icon.astro";
import { getTopic } from "@lib/taxonomy";
import type { Project } from "@lib/projects";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  author: string;
  tags: string[];
  headings: MarkdownHeading[];
  project?: Project;
  relatedPosts?: CollectionEntry<"blog">[];
  isLearningNote?: boolean;
}
const { title, description, pubDate, updatedDate, category, author, tags, headings,
  project, relatedPosts = [], isLearningNote = false } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const formattedDate = pubDate.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${title} | 박원창`} description={description}>
  <main id="main-content" tabindex="-1" class="site-shell">
    <article>
      <header class="reading-header">
        <a class="back-link" href="/posts/">← 전체 글</a>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <p class="article-meta"><span>{getTopic(category)}</span>{project && <a href={`/about/#${project.id}`}>{project.name}</a>}<span>{author}</span><time datetime={pubDate.toISOString()}>{formattedDate}</time>{updatedDate && <time datetime={updatedDate.toISOString()}>수정 {updatedDate.toLocaleDateString("ko-KR")}</time>}{isLearningNote && <span>학습 노트</span>}</p>
        <ul class="tag-list" aria-label="기술 태그">{tags.map((tag) => <li>{tag}</li>)}</ul>
      </header>
      <div class="reading-grid">
        <div>
          {tocHeadings.length > 0 && <details class="mobile-toc">
            <summary>이 글의 목차 <Icon name="caret-down" /></summary>
            <nav aria-label="모바일 글 목차"><ul>{tocHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
          </details>}
          <div class="article-body"><slot /></div>
          <footer class="article-followup">
            {project && <section aria-labelledby="project-followup-title">
              <p class="eyebrow">Project</p>
              <h2 id="project-followup-title">{project.name}</h2>
              <p>{project.description}</p>
              <a class="section-link" href={`/about/#${project.id}`}>프로젝트의 설계 맥락 보기 <Icon /></a>
            </section>}
            {relatedPosts.length > 0 && <section class="related-posts" aria-labelledby="related-posts-title">
              <h2 id="related-posts-title">이어서 읽기</h2>
              <ul class="related-list">{relatedPosts.map((post) => <li><a href={`/posts/${post.id}/`}><span>{getTopic(post.data.category)}</span>{post.data.title}</a></li>)}</ul>
            </section>}
          </footer>
        </div>
        {tocHeadings.length > 0 && <aside class="toc" aria-label="글 목차">
          <h2>이 글의 목차</h2><nav><ul>{tocHeadings.map((heading) => <li class:list={{ "toc-sub": heading.depth === 3 }}><a data-toc-link href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
        </aside>}
      </div>
    </article>
  </main>
  <script>
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const sectionHeadings = Array.from(document.querySelectorAll<HTMLElement>(".article-body h2[id], .article-body h3[id]"));
    const getHashId = (hash: string) => {
      try { return decodeURIComponent(hash.replace(/^#/, "")); }
      catch { return hash.replace(/^#/, ""); }
    };
    const setCurrentHeading = (id: string) => {
      tocLinks.forEach((link) => {
        if (getHashId(link.hash) === id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    if (sectionHeadings.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrentHeading(visible[0].target.id);
      }, { rootMargin: "-80px 0px -70% 0px" });
      sectionHeadings.forEach((heading) => observer.observe(heading));
      setCurrentHeading(getHashId(window.location.hash) || sectionHeadings[0].id);
    }
    const mobileToc = document.querySelector<HTMLDetailsElement>(".mobile-toc");
    mobileToc?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { mobileToc.open = false; }));
    document.querySelectorAll<HTMLElement>(".article-body pre, .article-body table").forEach((element) => {
      element.tabIndex = 0;
      if (element.tagName === "PRE") {
        element.setAttribute("role", "region");
        element.setAttribute("aria-label", "코드 예제");
      }
    });
  </script>
</BaseLayout>
