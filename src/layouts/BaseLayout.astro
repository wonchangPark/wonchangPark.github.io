---
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@styles/global.css";
interface Props { title?: string; description?: string; }
const {
  title = "박원창 | 백엔드 개발자",
  description = "이벤트와 가격 처리, 정산 아키텍처, 운영 경험을 기록하는 백엔드 개발자 박원창의 기술 블로그"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [{ href: "/posts/", label: "글" }, { href: "/about/", label: "프로젝트" }, { href: "/resume/", label: "이력서" }];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="박원창의 새 글 구독" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <header class="site-header">
      <div class="site-shell nav">
        <a class="brand" href="/" aria-label="박원창 홈">박원창</a>
        <nav class="nav-links" aria-label="주요 메뉴">
          {links.map((link) => <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? "page" : undefined}>{link.label}</a>)}
          <a href="https://github.com/wonchangPark">GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <a href="/rss/">새 글 구독(RSS)</a>
      </div>
    </footer>
  </body>
</html>
