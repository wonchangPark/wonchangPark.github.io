---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";
import Icon from "@components/Icon.astro";
import { getRepresentativePosts } from "@lib/posts";
import { projects } from "@lib/projects";
const posts = (await getRepresentativePosts()).slice(0, 3);
---
<BaseLayout>
  <main id="main-content" tabindex="-1" class="site-shell">
    <section class="home-intro">
      <p class="eyebrow">Backend Engineer</p>
      <h1>백엔드 개발자 박원창</h1>
      <p class="home-statement">정산·승인·송금처럼 실패 비용이 큰 도메인을 안정적으로 설계합니다.</p>
      <p class="home-profile">Java/Spring Boot · Minish 2025.03–현재</p>
      <a class="button primary" href="/posts/">기술 글 읽기 <Icon /></a>
    </section>
    <section class="home-section" aria-labelledby="projects-title">
      <div class="section-head"><h2 id="projects-title">대표 프로젝트</h2><a class="section-link" href="/about/">전체 프로젝트 <Icon /></a></div>
      <div class="project-index">
        {projects.map((project, index) => (
          <article class="project-row">
            <span class="project-number">{String(index + 1).padStart(2, "0")}</span>
            <div class="project-row-main"><h3>{project.name}</h3>{project.id !== "walking-trip" && <p class="project-focus">{project.focus}</p>}<p class="project-description">{project.description}</p></div>
            <div class="project-actions">
              <a href={"/about/#" + project.id} aria-label={project.name + " 프로젝트 보기"}>프로젝트 보기 <Icon /></a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="home-section home-writing" aria-labelledby="writing-title">
      <div class="section-head"><h2 id="writing-title">기술 기록</h2><a class="section-link" href="/posts/">전체 글 <Icon /></a></div>
      <div class="post-list">{posts.map((post) => <PostCard post={post} compact />)}</div>
    </section>
  </main>
</BaseLayout>
