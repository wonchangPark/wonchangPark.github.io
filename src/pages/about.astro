---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";
import Icon from "@components/Icon.astro";
import { getRepresentativePosts } from "@lib/posts";
import { projects } from "@lib/projects";
const posts = await getRepresentativePosts();
---
<BaseLayout title="프로젝트 | 박원창" description="이벤트·가격 처리, 정산 아키텍처, 걸음여행의 도메인 설계와 개발 경험">
  <main id="main-content" tabindex="-1" class="site-shell project-page">
    <header class="page-intro">
      <p class="eyebrow">Projects</p><h1>문제에서 설계까지</h1>
      <p class="lead">이벤트·가격 처리와 정산 아키텍처, 제품으로 연결한 도메인 설계 경험입니다.</p>
      <div class="experience-links"><a class="section-link" href="/resume/">경력 보기 <Icon /></a><a class="section-link" href="/posts/">기술 글 읽기 <Icon /></a></div>
    </header>
    {projects.map((project, index) => <section id={project.id} class="project-detail" aria-labelledby={`${project.id}-title`}>
      <header><p class="eyebrow">{String(index + 1).padStart(2, "0")}</p><h2 id={`${project.id}-title`}>{project.name}</h2><p class="project-focus">{project.focus}</p></header>
      <div class="project-detail-body">
        {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {posts.some((post) => post.data.project === project.id) && <div aria-label={`${project.name} 관련 기술 글`}>
          <h3 class="project-reading-title">관련 기술 글</h3>
          {posts.filter((post) => post.data.project === project.id).map((post) => <PostCard post={post} compact />)}
        </div>}
      </div>
    </section>)}
  </main>
</BaseLayout>
